# Copy to .env (never commit .env)
# --- Content generation (optional; without it the system uses your vetted quote bank) ---
ANTHROPIC_API_KEY=
RL_MODEL=claude-sonnet-5-5

# --- Instagram publishing (Instagram Graph API) ---
IG_USER_ID=
IG_ACCESS_TOKEN=
# graph.facebook.com (Facebook Login) or graph.instagram.com (Instagram Login)
IG_API_HOST=graph.facebook.com
GRAPH_VERSION=v23.0

# Public URL where the queue folder is reachable, e.g. https://raw.githubusercontent.com/<you>/<repo>/main/queue
PUBLIC_BASE_URL=

# Safety: posts only publish if approved. Set to 1 ONLY after you trust the output.
AUTO_APPROVE=0
